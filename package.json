{
  "name": "ruta-financiera",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "main": "expo-router/entry",
  "scripts": {
    "check": "npm run typecheck && npm test && npm run export:web",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web --output-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:edge": "vitest run tests/assistantEdgeFunction.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=22.23.1"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.108.2",
    "expo": "54.0.35",
    "expo-asset": "~12.0.13",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "1.21.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "@types/react-test-renderer": "19.1.0",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.10",
    "babel-preset-expo": "~54.0.11",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2",
    "vitest": "4.1.10"
  }
}
