EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Supabase Edge Function secrets. Configure them with:
# supabase secrets set OPENAI_API_KEY=<openai-api-key>
# supabase secrets set OPENAI_MODEL=gpt-5.4-mini
# supabase secrets set ASSISTANT_DAILY_LIMIT=5
# supabase secrets set ASSISTANT_USAGE_TIME_ZONE=America/Bogota
# supabase secrets set SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
OPENAI_MODEL=gpt-5.4-mini
ASSISTANT_DAILY_LIMIT=1
ASSISTANT_USAGE_TIME_ZONE=America/Bogota
